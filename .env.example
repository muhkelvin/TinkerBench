# URL situs publik (saat lokal http://localhost:3000, saat di Vercel https://tinkerbench.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kredensial Supabase Project (didapat dari Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Kredensial Administrator Tinkerbench
ADMIN_EMAIL=admin@tinkerbench.dev
ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_SECRET=your-session-secret-random-hex
